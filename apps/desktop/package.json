{
  "name": "@folio/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "A premium, offline-first digital notebook for Windows.",
  "author": "Folio",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently --kill-others --success first \"pnpm dev:renderer\" \"pnpm dev:electron:watch\" \"pnpm dev:electron\"",
    "dev:renderer": "vite --host 127.0.0.1",
    "dev:electron:watch": "tsc -p tsconfig.electron.json --watch --preserveWatchOutput",
    "dev:electron": "wait-on http://127.0.0.1:5173 file:dist-electron/main.js file:dist-electron/preload.js && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron dist-electron/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "pnpm typecheck && pnpm build:renderer && pnpm build:electron",
    "package": "pnpm build && electron-builder --win --dir",
    "dist": "pnpm build && electron-builder --win nsis"
  },
  "dependencies": {
    "@folio/ui": "workspace:*",
    "@fontsource-variable/inter": "^5.2.8",
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.548.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.3",
    "vite": "^8.1.5",
    "wait-on": "^9.0.1"
  },
  "build": {
    "appId": "com.folio.desktop",
    "productName": "Folio",
    "asar": true,
    "directories": {
      "output": "../../release",
      "buildResources": "../../assets"
    },
    "files": [
      "dist/renderer/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../assets",
        "to": "assets"
      }
    ],
    "win": {
      "icon": "app-icon.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
